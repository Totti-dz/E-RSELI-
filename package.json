{
  "name": "erseli-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:sql": "node supabase/tests/sql-ddl.check.mjs && node supabase/tests/sql-behavior.check.mjs && node supabase/tests/sql-social.check.mjs && node supabase/tests/sql-legacy.check.mjs",
    "sql:build": "node supabase/build-all-in-one.mjs",
    "host:zip": "node scripts/pack-htdocs.mjs",
    "icons:android": "node scripts/make-icons.mjs && capacitor-assets generate --android",
    "sound:android": "node scripts/make-sound.mjs",
    "android:sync": "npm run build && node scripts/android-init.mjs",
    "android:apk": "npm run android:sync && cd android && gradlew assembleRelease",
    "android:init": "node scripts/android-init.mjs",
    "set-repo": "node scripts/set-repo.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@supabase/supabase-js": "^2.57.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.6.0",
    "@electric-sql/pglite": "^0.5.13",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.35.5",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "vitest": "^5.0.5"
  }
}
