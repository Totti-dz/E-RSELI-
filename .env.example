# ملاحظة: الإعداد الأساسي صار في public/config.js (يُقرأ وقت التشغيل ويمكن تعديله على الاستضافة).
# متغيرات VITE_SUPABASE_* أدناه اختيارية: تُستعمل فقط إن كان config.js فارغًا.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Map / routing
# VITE_TILE_PROVIDER: only "osm" is bundled today. Public OSM tiles are for
# development and low traffic; production needs a dedicated tile provider.
VITE_TILE_PROVIDER=osm
# Set to 1 to allow driving-route lookups (OSRM demo). Off by default so the
# UI never presents a demo endpoint as a production routing service.
VITE_ROUTING_ENABLED=0
VITE_OSM_SEARCH=0
VITE_MAP_PROVIDER=none

# --- Android app -------------------------------------------------------------
# Shown only on Android devices. Two ways to point at the APK:
#   1) VITE_GITHUB_REPO=owner/repo  → resolves to
#      https://github.com/owner/repo/releases/latest/download/ersel.apk
#      (the file name published by .github/workflows/android.yml)
#   2) VITE_ANDROID_APK_URL=https://.../ersel.apk  → exact link, wins over 1.
# When both are empty the UI offers the browser install path instead of a dead
# link. CI injects VITE_ANDROID_APK_URL automatically from the repository name.
VITE_GITHUB_REPO=
VITE_ANDROID_APK_URL=

# Set to true only after Firebase is configured (google-services.json present
# and the notify-order edge function deployed). Enables FCM push tokens.
VITE_PUSH_ENABLED=false

# Never put service_role, secret keys, or private credentials in VITE_*.
# Everything prefixed with VITE_ is shipped to the browser.
